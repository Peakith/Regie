# Wordt lokaal automatisch gevuld met: npm run env:lokaal  (schrijft .env.local)
# Alleen de publieke (anon/publishable) sleutel hoort in de browser. Nooit de service/secret key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<publieke-anon-sleutel>
# 'uit' als de lokale realtime-dienst niet draait; online (Supabase) altijd 'aan'.
VITE_REALTIME=aan
